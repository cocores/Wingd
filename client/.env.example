# Only needed when the frontend and backend are deployed to different
# origins (e.g. frontend on Vercel, backend on Render/Railway/Fly). Leave
# blank for local dev — the Vite dev server proxies /api, /uploads, and
# /socket.io to the backend for you. Set to the backend's full origin, no
# trailing slash, e.g. https://wingd-api.onrender.com
VITE_API_URL=

# Social login (optional — omit either to leave that provider's button hidden).
# Must match the server's GOOGLE_CLIENT_ID / APPLE_CLIENT_ID in server/.env.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# Push notifications (optional — leaving any of these blank hides the
# "Enable notifications" button). All values here are public web config,
# safe to ship to the browser (unlike the server's service account key).
# From a Firebase project with Cloud Messaging enabled:
# Project settings > General > Your apps > Web app, for the first six;
# Project settings > Cloud Messaging > Web Push certificates for the VAPID key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
