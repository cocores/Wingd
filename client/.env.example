# Only needed when the frontend and backend are deployed to different
# origins (e.g. frontend on Vercel, backend on Render/Railway/Fly). Leave
# blank for local dev — the Vite dev server proxies /api, /uploads, and
# /socket.io to the backend for you. Set to the backend's full origin, no
# trailing slash, e.g. https://wingd-api.onrender.com
VITE_API_URL=

# Social login (optional — omit either to leave that provider's button hidden).
# Must match the server's GOOGLE_CLIENT_ID / APPLE_CLIENT_ID in server/.env.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
