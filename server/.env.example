PORT=4000
JWT_SECRET=change-this-secret-in-production
CLIENT_ORIGIN=http://localhost:5173

# Firestore. For local dev, run `npm run emulator` in one terminal (starts
# the Firestore emulator on 127.0.0.1:8080) and set FIRESTORE_EMULATOR_HOST
# below — no real Firebase project or credentials needed then.
# For production: create a Firebase project, enable Firestore, set
# FIREBASE_PROJECT_ID to its project id, and set GOOGLE_APPLICATION_CREDENTIALS
# to the path of a downloaded service account key JSON (IAM & Admin > Service
# Accounts > generate key, needs the "Cloud Datastore User" role).
FIREBASE_PROJECT_ID=demo-wingd
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Social login (optional — omit either to leave that provider disabled).
# GOOGLE_CLIENT_ID must match the client ID used by VITE_GOOGLE_CLIENT_ID in client/.env.
GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID is your Sign in with Apple Services ID identifier
# (e.g. com.yourteam.wingd.web), matching VITE_APPLE_CLIENT_ID in client/.env.
APPLE_CLIENT_ID=
